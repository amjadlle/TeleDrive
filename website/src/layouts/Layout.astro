---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TeleDrive — Safe, Resumable Telegram Cloud Backup",
  description = "Turn Telegram into your personal, safe, and unlimited cloud backup. Standalone desktop app with SQLite queue, flood-wait protection, and automated scheduling for Windows & Linux.",
} = Astro.props;

const socialImage = "https://teledrive.mapki.in/logo.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="telegram uploader, cloud backup, telegram drive, file sync, telegram api, teledrive, personal cloud storage, sqlite queue" />
    <meta name="author" content="amjadlle" />
    <meta name="theme-color" content="#07090e" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="TeleDrive logo" />
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    <meta property="twitter:image:alt" content="TeleDrive logo" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <!-- Ambient glowing backgrounds -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-orb ambient-orb-1"></div>
      <div class="ambient-orb ambient-orb-2"></div>
      <div class="ambient-orb ambient-orb-3"></div>
    </div>
    <div class="grid-overlay" aria-hidden="true"></div>

    <slot />

    <!-- 💬 TeleDrive AI Chatbot (Powered by ZeroRoute) -->
    <script 
      src="https://zeroroute.mapki.in/widget.js" 
      data-endpoint="https://zeroroute.mapki.in"
      data-title="TeleDrive AI"
      data-logo="https://teledrive.mapki.in/logo.png"
      data-color="#24a1de"
      data-greeting="Hi! 👋 I'm TeleDrive AI. Ask me anything about cloud backup, Telegram file storage, or limits!"
      data-prompts="Is TeleDrive free to use?,How does Telegram storage work?,What are the file size limits?,How do I install/connect?"
      data-persona="You are TeleDrive AI, the smart virtual assistant for TeleDrive. Explain clearly and concisely how TeleDrive turns Telegram into unlimited free cloud storage with fast downloads and sharing."
      data-knowledge-url="https://teledrive.mapki.in/knowledge.md"
      data-knowledge="TeleDrive Features: Unlimited cloud storage via Telegram API, fast streaming, shareable file links, cross-platform support. Free tier with zero hosting costs."
      defer>
    </script>
  </body>
</html>
