---

<section class="author-section" id="author">
  <div class="container">
    <div class="author-card glass-card">
      <div class="author-layout">
        <!-- Headshot & Identity -->
        <div class="author-identity">
          <div class="avatar-frame">
            <img
              src="https://doting-octopus-124.convex.cloud/api/storage/730e2173-8a2f-4d38-8976-7624a53bbc88"
              alt="Amjad P A"
              class="avatar-photo"
              width="110"
              height="110"
              loading="lazy"
            />
          </div>

          <div class="identity-text">
            <div class="author-role-badge">Creator & Developer</div>
            <h3 class="author-name">Amjad P A</h3>
            <p class="author-handle">@amjadlle</p>
          </div>
        </div>

        <!-- Bio & Contact -->
        <div class="author-body">
          <p class="author-bio">
            Passionate software engineer and systems builder. Creator of <strong>TeleDrive</strong>, exploring autonomous backup architectures, cloud toolings, and high-performance modern web experiences.
          </p>

          <!-- Action buttons -->
          <div class="author-actions">
            <a href="https://buymeacoffee.com/amjadlle" target="_blank" rel="noopener noreferrer" class="btn btn-warning btn-sm author-coffee-btn" style="background: #ffdd00; color: #000; font-weight: 700; border: 0;">
              <span>☕</span>
              <span>Buy Me a Coffee</span>
            </a>

            <a href="mailto:hire.amjad@gmail.com" class="btn btn-primary btn-sm author-email-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>hire.amjad@gmail.com</span>
            </a>

            <a href="https://amjad.mapki.in" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm author-portfolio-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Portfolio</span>
            </a>
          </div>

          <!-- Social Links Matrix -->
          <div class="author-socials">
            {socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-pill"
                aria-label={social.name}
              >
                <span class="social-icon" set:html={social.icon} />
                <span class="social-name">{social.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .author-section {
    padding: 3rem 0 6rem;
    position: relative;
  }

  .author-card {
    padding: 2.75rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(10, 15, 26, 0.85);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(36, 161, 222, 0.1);
  }

  .author-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: center;
  }

  .author-identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    border-right: 1px solid var(--border-subtle);
    padding-right: 2rem;
  }

  .avatar-frame {
    width: 104px;
    height: 104px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #080c14;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(36, 161, 222, 0.15);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .avatar-frame:hover {
    transform: translateY(-2px);
    border-color: rgba(36, 161, 222, 0.5);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 25px rgba(36, 161, 222, 0.25);
  }

  .avatar-photo {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: cover;
    display: block;
  }

  .author-role-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--accent-primary);
    background: rgba(36, 161, 222, 0.12);
    border: 1px solid rgba(36, 161, 222, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 0.4rem;
  }

  .author-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .author-handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .author-body {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .author-bio {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .author-bio strong {
    color: #f1f5f9;
  }

  .author-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .author-email-btn, .author-portfolio-btn {
    border-radius: var(--radius-md);
  }

  .author-socials {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .social-pill:hover {
    color: #ffffff;
    background: rgba(36, 161, 222, 0.15);
    border-color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .social-icon {
    display: flex;
    align-items: center;
    color: var(--accent-primary);
  }

  @media (max-width: 880px) {
    .author-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .author-identity {
      border-right: none;
      padding-right: 0;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 2rem;
    }

    .author-body {
      text-align: center;
      align-items: center;
    }

    .author-actions {
      justify-content: center;
    }

    .author-socials {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .author-card {
      padding: 1.5rem;
    }
  }
</style>
