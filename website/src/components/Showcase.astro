---
---

<section class="showcase-section" id="showcase">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Visual Walkthrough</span>
      <h2 class="section-title">Engineered for Complete Transparency</h2>
      <p class="section-desc">
        Explore the PySide6 desktop client interface. Click any screenshot below to inspect high-resolution details in full view.
      </p>
    </div>

    <!-- Interactive Screenshot Tab Navigator -->
    <div class="showcase-tabs">
      <button class="showcase-tab active" data-target="dash">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
        <span>1. Main Dashboard</span>
      </button>

      <button class="showcase-tab" data-target="queue">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        <span>2. Resumable Upload Queue</span>
      </button>

      <button class="showcase-tab" data-target="settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        <span>3. Fine-Grained Timing Settings</span>
      </button>
    </div>

    <!-- Screenshot Display Panels (Cinematic Stage) -->
    <div class="showcase-viewport glass-card">
      <!-- Panel 1: Dashboard -->
      <div class="showcase-panel active" id="panel-dash">
        <div class="panel-layout">
          <!-- Main Image Canvas with Zoom Button -->
          <div class="panel-stage" data-img="/images/dashboard.png" data-title="TeleDrive — Main Dashboard">
            <div class="zoom-hint">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Click to view in Full HD</span>
            </div>
            <img src="/images/dashboard.png" alt="TeleDrive Dashboard Screenshot" class="showcase-img" loading="lazy" />
          </div>

          <!-- Crisp Key Highlights Bar -->
          <div class="highlights-grid">
            <div class="highlight-box">
              <div class="hl-tag">Batch Progress</div>
              <div class="hl-val">1 uploaded • 4 remaining</div>
              <div class="hl-sub">Real-time percentage progress bar</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">One-Click Actions</div>
              <div class="hl-val">Run Batch • Scan • Loop</div>
              <div class="hl-sub">Immediate control buttons</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">Live Activity Audit</div>
              <div class="hl-val">[INFO] Scan complete</div>
              <div class="hl-sub">Color-coded terminal log console</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Queue -->
      <div class="showcase-panel hidden" id="panel-queue">
        <div class="panel-layout">
          <div class="panel-stage" data-img="/images/upload-queue.png" data-title="TeleDrive — Upload Queue">
            <div class="zoom-hint">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Click to view in Full HD</span>
            </div>
            <img src="/images/upload-queue.png" alt="TeleDrive Upload Queue Screenshot" class="showcase-img" loading="lazy" />
          </div>

          <div class="highlights-grid">
            <div class="highlight-box">
              <div class="hl-tag">Queue State</div>
              <div class="hl-val">Pending • Uploading • Done</div>
              <div class="hl-sub">ACID-compliant SQLite persistence</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">File Integrity</div>
              <div class="hl-val">Size & Hash Auditing</div>
              <div class="hl-sub">Safely skips modified or missing files</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">Fail-Safe Retries</div>
              <div class="hl-val">Per-file Retry Logs</div>
              <div class="hl-sub">Tracks transient connection drops</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Settings -->
      <div class="showcase-panel hidden" id="panel-settings">
        <div class="panel-layout">
          <div class="panel-stage" data-img="/images/settings.png" data-title="TeleDrive — Settings Screen">
            <div class="zoom-hint">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Click to view in Full HD</span>
            </div>
            <img src="/images/settings.png" alt="TeleDrive Settings Screenshot" class="showcase-img" loading="lazy" />
          </div>

          <div class="highlights-grid">
            <div class="highlight-box">
              <div class="hl-tag">Timing Guard</div>
              <div class="hl-val">20s – 60s Jitter Delays</div>
              <div class="hl-sub">Human-like upload spacing</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">Flood Protection</div>
              <div class="hl-val">+30s Server Buffer</div>
              <div class="hl-sub">Prevents Telegram rate-limit penalties</div>
            </div>
            <div class="highlight-box">
              <div class="hl-tag">Credentials Vault</div>
              <div class="hl-val">Telegram API ID & Hash</div>
              <div class="hl-sub">Stored 100% locally on your PC</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div class="lightbox-overlay" id="lightbox-modal" aria-hidden="true">
    <div class="lightbox-dialog">
      <div class="lightbox-header">
        <span class="lightbox-title" id="lightbox-title">Screenshot Preview</span>
        <button class="lightbox-close" id="lightbox-close" aria-label="Close Fullscreen View">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="lightbox-body">
        <img src="" alt="" id="lightbox-img" class="lightbox-image" />
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-section {
    padding: 6rem 0;
    position: relative;
  }

  .showcase-tabs {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .showcase-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.35rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-smooth);
  }

  .showcase-tab:hover {
    color: var(--text-main);
    background: var(--bg-surface-hover);
    border-color: var(--border-medium);
  }

  .showcase-tab.active {
    background: rgba(36, 161, 222, 0.18);
    color: #ffffff;
    border-color: var(--accent-primary);
    box-shadow: 0 0 25px rgba(36, 161, 222, 0.25);
  }

  .showcase-tab.active svg {
    color: var(--accent-primary);
  }

  .showcase-viewport {
    background: rgba(10, 14, 23, 0.9);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
  }

  .showcase-panel.hidden {
    display: none;
  }

  .panel-layout {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .panel-stage {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #080c14;
    cursor: pointer;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
    transition: all 0.3s ease;
  }

  .panel-stage:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(36, 161, 222, 0.25);
  }

  .showcase-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .panel-stage:hover .showcase-img {
    transform: scale(1.015);
  }

  .zoom-hint {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(8, 12, 20, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e2e8f0;
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    transition: all var(--transition-fast);
  }

  .panel-stage:hover .zoom-hint {
    background: rgba(36, 161, 222, 0.9);
    color: #ffffff;
    border-color: #7dd3fc;
  }

  /* Highlights bar */
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .highlight-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.25rem;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .highlight-box:hover {
    background: rgba(36, 161, 222, 0.06);
    border-color: rgba(36, 161, 222, 0.3);
  }

  .hl-tag {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    margin-bottom: 0.35rem;
  }

  .hl-val {
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 0.25rem;
  }

  .hl-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Lightbox Modal */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(4, 6, 10, 0.92);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-dialog {
    width: 100%;
    max-width: 1200px;
    background: #080c14;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9), 0 0 50px rgba(36, 161, 222, 0.25);
    display: flex;
    flex-direction: column;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: rgba(14, 20, 34, 0.95);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .lightbox-close {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-medium);
    color: #e2e8f0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lightbox-close:hover {
    background: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
  }

  .lightbox-body {
    padding: 1rem;
    max-height: 80vh;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    background: #05070a;
  }

  .lightbox-image {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
    .lightbox-overlay {
      padding: 0.75rem;
    }
  }
</style>

<script>
  // Tab switching
  const sTabs = document.querySelectorAll('.showcase-tab');
  const panels = document.querySelectorAll('.showcase-panel');

  sTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      sTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const target = tab.getAttribute('data-target');
      panels.forEach(panel => {
        if (panel.id === `panel-${target}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  // Lightbox logic
  const stages = document.querySelectorAll('.panel-stage');
  const lightbox = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxClose = document.getElementById('lightbox-close');

  stages.forEach(stage => {
    stage.addEventListener('click', () => {
      const src = stage.getAttribute('data-img');
      const title = stage.getAttribute('data-title');
      if (lightbox && lightboxImg && src) {
        lightboxImg.src = src;
        if (lightboxTitle && title) lightboxTitle.textContent = title;
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
