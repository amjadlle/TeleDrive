---
---

<section class="hero-section">
  <div class="container">
    <!-- Top Announcement Pill -->
    <div class="hero-badge-wrapper">
      <div class="badge">
        <span class="badge-dot"></span>
        <span>TeleDrive v1.0.5 is Live • Windows & Linux</span>
      </div>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-title">
      Turn Telegram into your <br />
      <span class="gradient-text">Private, Unlimited Cloud</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      A safe, resumable, and autonomous personal file uploader for Windows and Linux.
      Gradually scans local folders, queues files in SQLite, and uploads directly to your private Saved Messages or Channel with intelligent flood-wait protection.
    </p>

    <!-- Download and Action Row -->
    <div class="hero-cta-group" id="download">
      <a
        href="https://github.com/amjadlle/TeleDrive/releases/download/v1.0.5/TeleDrive-Setup-1.0.5.exe"
        class="btn btn-primary btn-lg hero-cta-btn"
        id="hero-win-download"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"/>
        </svg>
        <span class="btn-main-text">Download for Windows</span>
        <span class="btn-subtext">.exe Installer</span>
      </a>

      <a
        href="https://github.com/amjadlle/TeleDrive/releases/download/v1.0.5/TeleDrive-linux-x86_64.tar.gz"
        class="btn btn-secondary btn-lg hero-cta-btn"
        id="hero-linux-download"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.504 0c-.155 0-.315.008-.48.021-3.156.261-4.73 2.316-4.939 4.908-.045.549.02 1.157.172 1.78-.328.324-.716.716-1.121 1.189-1.066 1.246-1.928 2.614-2.295 3.828-.432 1.428-.318 2.593.351 3.551.464.665 1.18 1.139 2.059 1.402-.027.382-.04.773-.04 1.173 0 1.455.207 2.812.617 4.025.433 1.282 1.096 2.073 1.954 2.327.287.085.6.115.932.088.752-.061 1.584-.367 2.45-.889.866.522 1.698.828 2.45.889.332.027.645-.003.932-.088.858-.254 1.521-1.045 1.954-2.327.41-1.213.617-2.57.617-4.025 0-.4-.013-.791-.04-1.173.879-.263 1.595-.737 2.059-1.402.669-.958.783-2.123.351-3.551-.367-1.214-1.229-2.582-2.295-3.828-.405-.473-.793-.865-1.121-1.189.152-.623.217-1.231.172-1.78-.209-2.592-1.783-4.647-4.939-4.908-.165-.013-.325-.021-.48-.021z"/>
        </svg>
        <span class="btn-main-text">Download for Linux</span>
        <span class="btn-subtext">x86_64 Package</span>
      </a>
    </div>

    <!-- Quick 1-line Install Terminal Box -->
    <div class="terminal-card glass-card">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <div class="terminal-tabs">
          <button class="term-tab active" data-os="windows">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"/></svg>
            <span>Windows PowerShell / CMD</span>
          </button>
          <button class="term-tab" data-os="linux">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.504 0c-.155 0-.315.008-.48.021-3.156.261-4.73 2.316-4.939 4.908-.045.549.02 1.157.172 1.78-.328.324-.716.716-1.121 1.189-1.066 1.246-1.928 2.614-2.295 3.828-.432 1.428-.318 2.593.351 3.551.464.665 1.18 1.139 2.059 1.402-.027.382-.04.773-.04 1.173 0 1.455.207 2.812.617 4.025.433 1.282 1.096 2.073 1.954 2.327.287.085.6.115.932.088.752-.061 1.584-.367 2.45-.889.866.522 1.698.828 2.45.889.332.027.645-.003.932-.088.858-.254 1.521-1.045 1.954-2.327.41-1.213.617-2.57.617-4.025 0-.4-.013-.791-.04-1.173.879-.263 1.595-.737 2.059-1.402.669-.958.783-2.123.351-3.551-.367-1.214-1.229-2.582-2.295-3.828-.405-.473-.793-.865-1.121-1.189.152-.623.217-1.231.172-1.78-.209-2.592-1.783-4.647-4.939-4.908-.165-.013-.325-.021-.48-.021z"/></svg>
            <span>Linux Terminal</span>
          </button>
        </div>
        <div class="terminal-badge">⚡ Instant One-Liner</div>
      </div>

      <div class="terminal-body">
        <div class="command-view" id="cmd-windows">
          <span class="cmd-prompt">PS &gt;</span>
          <div class="cmd-scroll">
            <code class="cmd-text">irm "https://github.com/amjadlle/TeleDrive/releases/download/v1.0.5/TeleDrive-Setup-1.0.5.exe" -OutFile "$env:TEMP\TeleDrive-Setup.exe"; Start-Process "$env:TEMP\TeleDrive-Setup.exe"</code>
          </div>
        </div>
        <div class="command-view hidden" id="cmd-linux">
          <span class="cmd-prompt">$</span>
          <div class="cmd-scroll">
            <code class="cmd-text">pkill -x TeleDrive 2&gt;/dev/null || true; curl -fL --progress-bar -o /tmp/TeleDrive.tar.gz "https://github.com/amjadlle/TeleDrive/releases/download/v1.0.5/TeleDrive-linux-x86_64.tar.gz" &amp;&amp; tar -xzf /tmp/TeleDrive.tar.gz -C "$HOME" &amp;&amp; "$HOME/TeleDrive/TeleDrive"</code>
          </div>
        </div>

        <button class="copy-btn" id="copy-btn" aria-label="Copy Command">
          <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>

    <!-- App Showcase Mockup in Hero -->
    <div class="hero-preview-wrapper">
      <div class="hero-preview-container">
        <div class="preview-glow"></div>
        <a href="#showcase" class="hero-mockup glass-card" aria-label="Inspect TeleDrive Dashboard in detail">
          <div class="mockup-header">
            <div class="mockup-circles">
              <span></span><span></span><span></span>
            </div>
            <div class="mockup-title">TeleDrive Desktop — Production Client</div>
            <div class="mockup-status">
              <span class="status-live-dot"></span>
              <span>Uploader Engine Active</span>
            </div>
          </div>
          <div class="mockup-image-frame">
            <div class="hero-zoom-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Click to view details</span>
            </div>
            <img src="/images/dashboard.png" alt="TeleDrive Desktop Dashboard" class="mockup-img" width="1200" height="750" loading="eager" />
          </div>
        </a>
      </div>
    </div>

    <!-- Trust badges row -->
    <div class="trust-row">
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Zero Third-Party Cloud</span>
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        <span>No Python Required (.exe)</span>
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
        <span>Automated Loop Scheduling</span>
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
        <span>MIT Open Source</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 9.5rem 0 3.5rem;
    text-align: center;
    position: relative;
  }

  .hero-badge-wrapper {
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.65;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-cta-btn {
    position: relative;
    overflow: hidden;
  }

  .btn-main-text {
    font-weight: 700;
  }

  .btn-subtext {
    font-size: 0.75rem;
    opacity: 0.8;
    font-weight: 500;
    padding-left: 0.25rem;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  /* Terminal box */
  .terminal-card {
    max-width: 820px;
    margin: 0 auto 3.5rem;
    text-align: left;
    background: rgba(8, 12, 20, 0.95);
    border: 1px solid rgba(36, 161, 222, 0.28);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(36, 161, 222, 0.12);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .terminal-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .term-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .term-tab:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.05);
  }

  .term-tab.active {
    background: rgba(36, 161, 222, 0.18);
    color: #7dd3fc;
    border-color: rgba(36, 161, 222, 0.45);
  }

  .terminal-badge {
    font-size: 0.725rem;
    color: var(--accent-cyan);
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .terminal-body {
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .command-view {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    min-width: 0;
    flex-grow: 1;
  }

  .command-view.hidden {
    display: none;
  }

  .cmd-prompt {
    color: var(--accent-primary);
    font-weight: 700;
    user-select: none;
    flex-shrink: 0;
  }

  .cmd-scroll {
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.25rem 0;
  }

  .cmd-scroll::-webkit-scrollbar {
    display: none;
  }

  .cmd-text {
    color: #7dd3fc;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-medium);
    color: var(--text-main);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .copy-btn:hover {
    background: rgba(36, 161, 222, 0.2);
    border-color: var(--accent-primary);
    color: #ffffff;
  }

  .copy-btn.copied {
    background: rgba(16, 185, 129, 0.2);
    border-color: var(--accent-emerald);
    color: #34d399;
  }

  /* Mockup Frame */
  .hero-preview-wrapper {
    padding: 0 1rem;
    margin-bottom: 3.5rem;
  }

  .hero-preview-container {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .preview-glow {
    position: absolute;
    inset: -30px;
    background: radial-gradient(circle at 50% 50%, rgba(36, 161, 222, 0.25) 0%, transparent 70%);
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
  }

  .hero-mockup {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #080c14;
    overflow: hidden;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.85), 0 0 50px rgba(36, 161, 222, 0.18);
  }

  .mockup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: rgba(14, 20, 34, 0.9);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mockup-circles {
    display: flex;
    gap: 6px;
  }
  .mockup-circles span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .mockup-title {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .mockup-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .status-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: pulse-dot 1.8s infinite;
  }

  .mockup-image-frame {
    position: relative;
    width: 100%;
    line-height: 0;
  }

  .hero-zoom-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(8, 12, 20, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e2e8f0;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.2s ease;
  }

  .hero-mockup:hover .hero-zoom-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .mockup-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Trust Row */
  .trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .trust-item svg {
    color: var(--accent-primary);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 6.5rem 0 2rem;
    }
    .hero-title {
      font-size: clamp(2rem, 7.5vw, 2.75rem);
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 380px;
      margin-left: auto;
      margin-right: auto;
      gap: 1rem;
    }
    .hero-cta-btn {
      width: 100%;
    }
    .terminal-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .terminal-badge {
      display: none;
    }
    .trust-row {
      gap: 1.25rem;
      justify-content: flex-start;
    }
  }
</style>

<script>
  // Tab switching for terminal command
  const tabs = document.querySelectorAll('.term-tab');
  const winCmd = document.getElementById('cmd-windows');
  const linuxCmd = document.getElementById('cmd-linux');
  const copyBtn = document.getElementById('copy-btn');
  let activeOS = 'windows';

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeOS = tab.getAttribute('data-os') || 'windows';

      if (activeOS === 'windows') {
        winCmd?.classList.remove('hidden');
        linuxCmd?.classList.add('hidden');
      } else {
        winCmd?.classList.add('hidden');
        linuxCmd?.classList.remove('hidden');
      }
    });
  });

  // Copy button logic
  copyBtn?.addEventListener('click', async () => {
    const textToCopy = activeOS === 'windows' 
      ? winCmd?.querySelector('.cmd-text')?.textContent || ''
      : linuxCmd?.querySelector('.cmd-text')?.textContent || '';

    try {
      await navigator.clipboard.writeText(textToCopy);
      copyBtn.classList.add('copied');
      const label = copyBtn.querySelector('.copy-label');
      if (label) label.textContent = 'Copied!';

      setTimeout(() => {
        copyBtn.classList.remove('copied');
        if (label) label.textContent = 'Copy';
      }, 2000);
    } catch (err) {
      console.error('Failed to copy', err);
    }
  });
</script>
