---
---

<header class="header-container">
  <nav class="floating-nav">
    <!-- Brand -->
    <a href="#" class="brand-link">
      <img src="/logo.png" alt="TeleDrive Logo" class="brand-logo" width="28" height="28" />
      <span class="brand-title">TeleDrive</span>
      <span class="brand-version">v1.0.1</span>
    </a>

    <!-- Center Navigation Links (Clean & Direct) -->
    <div class="nav-center">
      <a href="#features" class="nav-item">Features</a>
      <a href="#showcase" class="nav-item">Screenshots</a>
      <a href="#simulator" class="nav-item">Simulator</a>
      <a href="#settings" class="nav-item">Presets</a>
      <a href="#faq" class="nav-item">FAQ</a>
    </div>

    <!-- Right Actions -->
    <div class="nav-right">
      <a
        href="https://github.com/amjadlle/TeleDrive"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label="GitHub Repository"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span>GitHub</span>
        <span class="star-count">★ Star</span>
      </a>

      <a href="#download" class="cta-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header-container {
    position: fixed;
    top: 1.25rem;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 1.25rem;
    pointer-events: none;
  }

  .floating-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1020px);
    padding: 0.55rem 0.85rem 0.55rem 1.15rem;
    border-radius: 14px;
    background: rgba(10, 15, 26, 0.82);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
      0 16px 40px -10px rgba(0, 0, 0, 0.7),
      inset 0 1px 1px rgba(255, 255, 255, 0.2),
      0 0 25px rgba(36, 161, 222, 0.12);
    transition: all 0.25s ease;
  }

  .floating-nav:hover {
    border-color: rgba(36, 161, 222, 0.35);
    box-shadow: 
      0 20px 45px -10px rgba(0, 0, 0, 0.8),
      inset 0 1px 1px rgba(255, 255, 255, 0.25),
      0 0 35px rgba(36, 161, 222, 0.18);
  }

  /* Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand-logo {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    object-fit: contain;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .brand-version {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 6px;
    background: rgba(36, 161, 222, 0.15);
    color: #7dd3fc;
    border: 1px solid rgba(36, 161, 222, 0.35);
  }

  /* Center Links (No nested box, clean inline list) */
  .nav-center {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    text-decoration: none;
    color: #94a3b8;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Right Actions */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .github-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .star-count {
    font-family: var(--font-mono);
    padding: 0.1rem 0.4rem;
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 4px;
    font-size: 0.6875rem;
    color: #fbbf24;
    font-weight: 700;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.15rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #24a1de 0%, #0088cc 100%);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(36, 161, 222, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: all 0.2s ease;
  }

  .cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(36, 161, 222, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 860px) {
    .nav-center {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-container {
      top: 0.75rem;
      padding: 0 0.75rem;
    }
    .floating-nav {
      padding: 0.45rem 0.75rem;
    }
    .brand-title {
      font-size: 1.05rem;
    }
    .brand-version {
      display: none;
    }
    .github-link {
      display: none;
    }
    .cta-btn {
      padding: 0.4rem 0.85rem;
      font-size: 0.75rem;
    }
  }
</style>
