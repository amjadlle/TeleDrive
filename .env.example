PUID=1000
PGID=1000
TELEDRIVE_BIND_ADDRESS=127.0.0.1
TELEDRIVE_WEB_PORT=8080
TELEDRIVE_S3_PORT=9000
TELEDRIVE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TELEDRIVE_ALLOW_INSECURE=0
TELEDRIVE_WEB_USER=admin
TELEDRIVE_WEB_PASSWORD=
# Run explicitly queued local upload jobs in the shared object catalog; no auto-scan.
TELEDRIVE_JOB_AUTO_RUN=1
TZ=Europe/Istanbul

# Space-separated pip package(s) for the database dialect/DBAPI you want.
# Examples:
#   oracledb
#   pymssql
#   pyodbc
#   cockroachdb
#   snowflake-sqlalchemy
#   ibm-db-sa
TELEDRIVE_DB_EXTRA_PACKAGES=

# Optional Telegram Bot API transport for REST binary object PUT/GET.
# Grant the bot administrator/post permissions in a private test/storage channel.
# Telegram Bot API cloud download limit is 20 MiB per file; TeleDrive chunks at 16 MiB.
# Keep these values out of Git and never reuse production bot credentials in CI.
TELEDRIVE_STORAGE_BOT_TOKEN=
TELEDRIVE_STORAGE_BOT_CHAT_ID=
TELEDRIVE_REST_MAX_UPLOAD_BYTES=2147483648
