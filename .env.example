PUID=1000
PGID=1000
TELEDRIVE_BIND_ADDRESS=127.0.0.1
TELEDRIVE_WEB_PORT=8080
TELEDRIVE_S3_PORT=9000
TELEDRIVE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TELEDRIVE_ALLOW_INSECURE=0
TELEDRIVE_WEB_USER=admin
TELEDRIVE_WEB_PASSWORD=
# Run explicitly queued local upload jobs in the shared object catalog; no auto-scan.
TELEDRIVE_JOB_AUTO_RUN=1
# Optional: ingest eligible files from the configured legacy upload source
# into the SAME REST/S3 object catalog through this one service's durable queue.
# Leave the bucket EMPTY unless deliberately switching to unified ingest.
# Before enabling: disable legacy app.auto_run, set upload.source_dir under
# /uploads, configure an authorized USER channel and create the destination bucket.
# Do not run an independent legacy uploader concurrently.
TELEDRIVE_JOB_LEGACY_AUTO_BUCKET=
TELEDRIVE_JOB_LEGACY_AUTO_PREFIX=
TELEDRIVE_JOB_LEGACY_AUTO_LIMIT=100
TZ=Europe/Istanbul

# Space-separated pip package(s) for the database dialect/DBAPI you want.
# Examples:
#   oracledb
#   pymssql
#   pyodbc
#   cockroachdb
#   snowflake-sqlalchemy
#   ibm-db-sa
TELEDRIVE_DB_EXTRA_PACKAGES=

# The unified REST/S3/local-job engine uses an authorized Telethon USER only.
# Bot uploads are retired: stale Bot tokens are never used, even if present.
# No Saved Messages support. Use a dedicated private broadcast channel.
# Store a preauthorized StringSession in ./config/mtproto-user.session (0600).
# Historic Bot messages can be read via authorized USER access to the exact
# original channel and SQL message IDs; other channels require migration.
TELEDRIVE_STORAGE_TRANSPORT=telethon
TELEDRIVE_STORAGE_MTPROTO_API_ID=
TELEDRIVE_STORAGE_MTPROTO_API_HASH=
TELEDRIVE_STORAGE_MTPROTO_CHANNEL=
TELEDRIVE_STORAGE_MTPROTO_ACCOUNT=mtproto-user

TELEDRIVE_REST_MAX_UPLOAD_BYTES=2147483648
